	},
	"dependencies": {
		"solid-js": "^1.9.13"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"typescript": "~6.0.2",
		"vite": "^8.1.1",
		"vite-plugin-solid": "^2.11.12",
		"wrangler": "^4.115.0"
	}
}