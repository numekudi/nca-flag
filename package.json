{
	"name": "nca-flag",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm run build:wasm && vite",
		"build:wasm": "wasm-pack build nca-wasm --target web --out-dir pkg",
		"build": "pnpm run build:wasm && tsc -b && vite build",
